<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Impresión Bluetooth.
         API 31+ (Android 12+): permisos en tiempo de ejecución, se piden desde la app.
         `neverForLocation` en SCAN declara que el escaneo no se usa para derivar ubicación,
         y evita que el sistema exija además ACCESS_FINE_LOCATION. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- API 30- (Android 11 y anteriores): permisos de instalación, sin diálogo en runtime. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- La comanda no debe perderse por Doze: la app pide la excepción al usuario. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Impresoras USB (ESC/POS). `required=false` a propósito: la app tiene que instalarse
         igual en tablets sin USB host, que imprimen por Bluetooth o por red. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Pedir los permisos BLUETOOTH/BLUETOOTH_ADMIN hace que Android *infiera*
         `android.hardware.bluetooth` como requerido, y eso excluiría tablets sin Bluetooth —
         que sí pueden imprimir por red o por USB. Declararlo explícito y opcional desactiva la
         inferencia. Mismo criterio que `usb.host`: ningún transporte es obligatorio. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
